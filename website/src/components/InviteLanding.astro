---
// The landing page for invitation links (https://wuselwall.app/i/#<token>). The token is in
// the fragment, so this page is served the same for every invitation and never sees it. No
// script: the app reads the link itself once it is installed (specs/20, landing pages).
import Base from '../layouts/Base.astro';
import StoreBadges from './StoreBadges.astro';
import { paths, strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const i = t.invite;
---

<Base lang={lang} page="invite" title={i.title} description={i.description} noindex={true}>
  <div class="wrap prose legal">
    <h1>{i.heading}</h1>
    <p>{i.what}</p>
    <p><strong>{i.steps}</strong></p>
    <StoreBadges lang={lang} />
    <p>{i.personal}</p>
    <p><a href={paths[lang].privacy}>{t.footer.privacy}</a></p>
  </div>
</Base>
