---
import Base from '../layouts/Base.astro';
import { countryName, legal, unfilledLegal } from '../config/site';
import { strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<Base lang={lang} page="imprint" title={`${t.legal.imprintTitle} – WuselWall`} description={t.legal.imprintDescription} noindex={unfilledLegal.length > 0}>
  <div class="wrap prose legal">
    <h1>{t.legal.imprintTitle}</h1>
    {unfilledLegal.length > 0 && <p class="warn" role="alert">{t.legal.placeholderWarning}</p>}

    <h2>{t.legal.operator}</h2>
    <address set:html={[legal.operator, legal.street, legal.city, countryName(lang)].filter(Boolean).map(esc).join('<br />')} />

    <h2>{t.legal.contact}</h2>
    <p>
      {t.legal.email}: <a href={`mailto:${legal.email}`}>{legal.email}</a>
      {legal.phone && <><br />{t.legal.phone}: {legal.phone}</>}
    </p>

    <h2>{t.legal.liability}</h2>
    <p>{t.legal.liabilityText}</p>

    <h2>{t.legal.trademarksTitle}</h2>
    {t.legal.trademarks.map((m) => <p>{m}</p>)}
  </div>
</Base>
