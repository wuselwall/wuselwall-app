---
import Base from '../layouts/Base.astro';
import GitHubMark from './GitHubMark.astro';
import Screen from './Screen.astro';
import StoreBadges from './StoreBadges.astro';
import { site } from '../config/site';
import { strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const docs = lang === 'de' ? site.docs : `${site.docs}en/`;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: site.name,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'iOS, Android, Web',
      description: t.description,
      url: new URL(lang === 'de' ? '/' : '/en/', site.url).toString(),
      inLanguage: ['de', 'en'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
      codeRepository: site.github,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
    },
    { '@type': 'Organization', name: site.name, url: site.url, logo: `${site.url}/logo.svg`, sameAs: [site.github] },
  ],
};
---

<Base lang={lang} page="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <p class="kicker">{t.hero.kicker}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta">
          <a class="btn" href="#eigener-server">{t.hero.primary}</a>
          <a class="btn btn-ghost" href={site.github} rel="noopener"><GitHubMark />{t.hero.github}</a>
        </div>
        <StoreBadges lang={lang} />
      </div>
      <div class="hero-shot">
        <div class="device device-tablet">
          <Screen lang={lang} name="wall-board" alt={t.hero.shotAlt} widths={[800, 1200, 1600]} sizes="(min-width: 64rem) 56rem, 92vw" eager />
        </div>
        <div class="device device-phone">
          <Screen lang={lang} name="shopping-phone" alt={t.hero.phoneAlt} widths={[300, 600]} sizes="(min-width: 64rem) 13rem, 28vw" eager />
        </div>
      </div>
    </div>
  </section>

  <section id="funktionen" class="tinted">
    <div class="wrap">
      <h2>{t.featuresTitle}</h2>
      <div class="grid">
        {t.features.map((f) => (
          <article class="card"><h3>{f.title}</h3><p>{f.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t.viewsTitle}</h2>
      <p class="section-lead">{t.viewsLead}</p>
      <div class="views">
        {t.views.map((v) => (
          <figure class="view">
            <div class="view-shot">
              <Screen lang={lang} name={v.shot} alt={v.alt} widths={[400, 800]} sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 45vw, 92vw" />
            </div>
            <figcaption><h3>{v.title}</h3><p>{v.text}</p></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="eigener-server" class="tinted">
    <div class="wrap">
      <h2>{t.selfHostTitle}</h2>
      <p class="section-lead">{t.selfHostLead}</p>
      <ol class="steps">
        {t.selfHostSteps.map((s) => (
          <li class="card"><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="note">{t.selfHostNote}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t.principlesTitle}</h2>
      <div class="grid">
        {t.principles.map((f) => (
          <article class="card"><h3>{f.title}</h3><p>{f.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="stand" class="tinted">
    <div class="wrap">
      <h2>{t.statusTitle}</h2>
      <p>{t.statusLead}</p>
      <ul class="status">
        {t.status.map((s) => (
          <li><span>{s.label}</span><span class:list={['pill', { done: s.done }]}>{s.state}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="fragen">
    <div class="wrap narrow">
      <h2>{t.faqTitle}</h2>
      <div class="faq">
        {t.faq.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.a} /></details>
        ))}
      </div>
    </div>
  </section>

  <section id="open-source" class="tinted">
    <div class="wrap narrow">
      <h2>{t.openTitle}</h2>
      <p>{t.openText}</p>
      <div class="cta">
        <a class="btn" href={site.github} rel="noopener"><GitHubMark />{t.openCta}</a>
        <a class="btn btn-ghost" href={docs}>{t.docsCta}</a>
      </div>
    </div>
  </section>

</Base>
