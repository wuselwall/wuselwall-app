---
// The landing page for pairing QR codes (https://wuselwall.app/p/#<code>@<host>). The code and
// the server are in the fragment, so this page is served the same for every device and never
// sees them. No script: the app reads the link itself once it is installed (specs/20, landing
// pages).
import Base from '../layouts/Base.astro';
import StoreBadges from './StoreBadges.astro';
import { paths, strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const p = t.pair;
---

<Base lang={lang} page="pair" title={p.title} description={p.description} noindex={true}>
  <div class="wrap prose legal">
    <h1>{p.heading}</h1>
    <p>{p.what}</p>
    <p><strong>{p.steps}</strong></p>
    <StoreBadges lang={lang} />
    <p>{p.personal}</p>
    <p><a href={paths[lang].privacy}>{t.footer.privacy}</a></p>
  </div>
</Base>
