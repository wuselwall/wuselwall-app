---
// An app screenshot (src/assets/screens, `npm run sync-screens`) in the page's language,
// switching to the dark-theme shot with the visitor's colour scheme.
import { getImage } from 'astro:assets';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  name: string;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
}
const { lang, name, alt, widths, sizes, eager = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*.webp', { eager: true });
const pick = (suffix: string) => {
  const file = files[`../assets/screens/${lang}/${name}${suffix}.webp`];
  if (!file) throw new Error(`screen ${lang}/${name}${suffix} missing: run npm run sync-screens`);
  return file.default;
};
const lightSrc = pick('');
const light = await getImage({ src: lightSrc, widths, format: 'webp' });
const dark = await getImage({ src: pick('-dark'), widths, format: 'webp' });
---
<picture>
  <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={sizes} />
  <img
    class={Astro.props.class}
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={lightSrc.width}
    height={lightSrc.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>
