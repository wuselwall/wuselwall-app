---
// The official store badges (public/badges/, unmodified artwork from Apple and Google),
// shown only once a store URL is set in config/site.ts: Apple licenses its badge only for
// apps that are available. The App Store badge comes first (Apple's guidelines).
import { site } from '../config/site';
import { strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const { ios, android } = site.stores;
---
{ios || android ? (
  <div class="stores" role="group" aria-label={t.hero.stores}>
    {ios && (
      <a class="store" href={ios} rel="noopener">
        <img src={`/badges/app-store-${lang}.svg`} alt={t.badges.iosAlt} height="48" width="144" />
      </a>
    )}
    {android && (
      <a class="store" href={android} rel="noopener">
        <img src={`/badges/google-play-${lang}.png`} alt={t.badges.androidAlt} height="48" width={lang === 'de' ? 162 : 161} />
      </a>
    )}
  </div>
) : (
  <p class="stores-soon">{t.hero.storesSoon}</p>
)}
