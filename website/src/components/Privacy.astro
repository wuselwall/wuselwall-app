---
import Base from '../layouts/Base.astro';
import { countryName, legal, site, unfilledLegal } from '../config/site';
import { paths, strings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const p = t.privacy;

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// The paragraphs are our own strings (i18n) with inline HTML; only the config values
// substituted into them are escaped.
const tokens: Record<string, string> = {
  operator: esc([legal.operator, legal.street, legal.city, countryName(lang)].filter(Boolean).join(', ')),
  email: `<a href="mailto:${esc(legal.email)}">${esc(legal.email)}</a>`,
  logDays: esc(legal.logRetentionDays),
  github: `<a href="${esc(site.github)}" rel="noopener">GitHub</a>`,
  docs: `<a href="${lang === 'de' ? site.docs : `${site.docs}en/`}">${t.footer.docs}</a>`,
  imprint: `<a href="${paths[lang].imprint}">${t.footer.imprint}</a>`,
};
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (m, k) => tokens[k] ?? m);
---

<Base lang={lang} page="privacy" title={`${t.legal.privacyTitle} – WuselWall`} description={t.legal.privacyDescription} noindex={unfilledLegal.length > 0}>
  <div class="wrap prose legal">
    <h1>{t.legal.privacyTitle}</h1>
    <p class="updated">{p.updated}</p>
    {unfilledLegal.length > 0 && <p class="warn" role="alert">{t.legal.placeholderWarning}</p>}

    <aside class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title">{p.summaryTitle}</h2>
      <ul>
        {p.summary.map((s) => <li set:html={fill(s)} />)}
      </ul>
    </aside>

    {p.sections.map((section) => (
      <>
        <h2>{section.title}</h2>
        {section.body.map((para) => <p set:html={fill(para)} />)}
      </>
    ))}
  </div>
</Base>
