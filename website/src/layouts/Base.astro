---
import '../styles/global.css';
import GitHubMark from '../components/GitHubMark.astro';
import { site } from '../config/site';
import { alternate, paths, strings, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'home' | 'imprint' | 'privacy';
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, page, noindex = false } = Astro.props;
const t = strings[lang];
const title = Astro.props.title ?? t.title;
const description = Astro.props.description ?? t.description;
const here = paths[lang][page];
const other = lang === 'de' ? 'en' : 'de';
const canonical = new URL(here, site.url).toString();
const alt = new URL(alternate(lang, page), site.url).toString();
const home = paths[lang].home;
const image = new URL(lang === 'de' ? '/og-image.png' : '/og-image-en.png', site.url).toString();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'de' ? 'de-CH' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'de' ? 'de-CH' : 'en'} href={alt} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.de[page], site.url).toString()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="bar">
      <div class="wrap bar-inner">
        <a class="brand" href={paths[lang].home} aria-label={site.name}>
          <img src="/logo.svg" alt="" width="40" height="40" />
          <span>{site.name}</span>
        </a>
        <nav aria-label={t.nav.label}>
          <a href={`${home}#funktionen`} class="hide-sm">{t.nav.features}</a>
          <a href={`${home}#eigener-server`} class="hide-sm">{t.nav.selfHost}</a>
          <a href={`${home}#stand`} class="hide-sm">{t.nav.status}</a>
          <a class="btn btn-small btn-ghost" href={site.github} rel="noopener"><GitHubMark size={18} />{t.nav.github}</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p>© {new Date().getFullYear()} {site.name} · {t.footer.note} · <a href={site.license.url} rel="noopener license">{t.footer.license}</a></p>
        <nav aria-label={t.footer.label}>
          <a href={paths[lang].imprint}>{t.footer.imprint}</a>
          <a href={paths[lang].privacy}>{t.footer.privacy}</a>
          <a href={lang === 'de' ? site.docs : `${site.docs}en/`}>{t.footer.docs}</a>
          <a href={site.github} rel="noopener" class="foot-gh"><GitHubMark size={16} />{t.footer.source}</a>
          <a href={alternate(lang, page)} hreflang={other} lang={other}>{t.footer.langSwitch}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
