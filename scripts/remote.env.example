# Copy to scripts/remote.env (git-ignored) to drive a server over SSH from a checkout with
# the scripts/remote-*.sh and deploy-*.sh. A server installed from a release needs none of
# this: it has server/wuselwall (docs/server).
WW_HOST=myserver                                   # an SSH host (alias in ~/.ssh/config)
WW_STACK_DIR=/srv/wuselwall/supabase               # the compose stack's directory there
WW_API_URL=https://api.example.org                 # make-env.mjs, for init-env
WW_WEB_URL=https://web.example.org
# WW_RP_ID=example.org                             # passkey relying party (default: web host)
WW_WEB_DIR=/srv/www/wuselwall                      # deploy-web.sh: where the web app is served from

WW_APK_DIR=/srv/www/wuselwall-download             # deploy-apk.sh: where the APK is served from
WW_APK_URL=https://example.org/download/wuselwall.apk
WW_BACKUP_DIR=/srv/backups/wuselwall               # backup.sh on the server
