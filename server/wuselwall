#!/usr/bin/env bash
# The operator's tool for a WuselWall server (ADR-018, decision 9; docs/server). It runs ON
# the server, inside an unpacked server release:
#
#   wuselwall/            this directory (any path, e.g. /srv/wuselwall)
#     wuselwall           this script
#     VERSION             the release
#     stack/              the compose stack: Supabase's files, WuselWall's layers, the Edge
#                         Functions, the web app; stack/.env and stack/volumes/db/data are
#                         created here and never shipped
#     migrations/         supabase/migrations
#     jobs/schedule.sql   the scheduled jobs (pg_cron)
#     backup/             backup.sh
#
# Commands:
#   install --api https://api.example.org --web https://web.example.org [--caddy] [--studio]
#           [--admin-email you@example.org] [--language de|en|fr|es] [--env old.env]
#                         a new server: secrets, stack, database, jobs, the setup key.
#                         --env reuses the .env of an earlier server (a move, a restore).
#   update [release.tar.gz | version] [--allow-downgrade]
#                         backup, then the new release's stack, migrations and jobs; a
#                         release is checked (signature, checksum) before it is unpacked,
#                         and one older than the installed release needs --allow-downgrade
#   verify <release.tar.gz | version>
#                         only the check: downloads a version into a temporary directory
#   backup [label]        a dump of the whole database into backups/ (BACKUP_DIR)
#   restore <db-….dump>   replaces the database with a backup (see docs/server/restore)
#   setup-token           a fresh single-use setup key for founding the household
#   language de|en|fr|es   choose the one language for server emails (default: de)
#   mail [status]         whether the server sends mail (it is optional)
#   mail smtp [--gmail] [--host h] [--port 587] [--user u] [--sender a] [--name n]
#                         sign-in codes by mail through any SMTP server; asks for the password
#   mail off              no mail: email and password only
#   mail test <address>   sends a test message through the configured SMTP server
#   password <email>      a one-time code to reset that account's password in the app
#   status | logs [service] | compose <args>
#
# Needs: Docker with Compose v2, openssl, tar, curl. Node.js is not needed: make-env.mjs runs
# in a Node container when node is missing. minisign is used when installed; without it,
# OpenSSL 3 checks the release signature.
#
# Environment: WW_REQUIRE_SIGNATURE=1 refuses a release whose signature cannot be checked.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
STACK=$ROOT/stack
DB=${DB_CONTAINER:-supabase-db}
REPO=${WW_REPO:-wuselwall/wuselwall-app}
NODE_IMAGE=node:22.12.0-alpine
# The minisign public key that signs every server release's SHA256SUMS (security review
# 2026-11-01, F9). The maintainer fills it in once, from the key pair whose secret half is the
# repository secret SERVER_RELEASE_MINISIGN_KEY (`minisign -G -W`; the public key is the
# second line of minisign.pub), and puts the same line into server/cloud-init.yaml and the
# server docs (scripts/cloud-init.test.mjs compares them). The installed script is what
# decides whether the next release is genuine, so an update can only be signed by this key.
# While it is the placeholder, only the checksum is checked, with a warning.
WW_RELEASE_PUBKEY=${WW_RELEASE_PUBKEY:-REPLACE-WITH-THE-RELEASE-PUBLIC-KEY}
FUNCTIONS_URL=http://api-gw:8000/functions/v1

say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { printf 'wuselwall: %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33mwuselwall: WARNING: %s\033[0m\n' "$*" >&2; }
compose() { (cd "$STACK" && docker compose "$@"); }
psql_db() { docker exec -i "$DB" psql -U postgres -X -q -t -A -v ON_ERROR_STOP=1 "$@"; }
env_value() { sed -n "s/^$1='\(.*\)'$/\1/p" "$STACK/.env"; }
# Sets NAME='value' in the stack's .env, replacing the line or adding it.
set_env() {
  local name=$1 value=$2
  if grep -q "^$name=" "$STACK/.env"; then
    sed -i "s|^$name=.*|$name='$value'|" "$STACK/.env"
  else
    printf "%s='%s'\n" "$name" "$value" >> "$STACK/.env"
  fi
}

preflight() {
  docker compose version > /dev/null 2>&1 || die "Docker Compose v2 is missing ('docker compose version')"
  command -v openssl > /dev/null || die "openssl is missing"
  [ -d "$STACK" ] || die "no stack/ next to this script: run it from an unpacked release"
}

wait_for_db() {
  for _ in $(seq 1 90); do
    docker exec "$DB" pg_isready -U postgres -q 2> /dev/null && return 0
    sleep 2
  done
  die "the database did not start; see: $0 logs db"
}

# Auth and Realtime create their own tables at startup (auth.*, realtime.messages), which
# the migrations build on: wait for them, not just for Postgres.
wait_for_services() {
  for _ in $(seq 1 90); do
    local pending=0 s
    for s in "$@"; do
      [ "$(compose ps --format '{{.Health}}' "$s" 2> /dev/null)" = healthy ] || pending=1
    done
    [ "$pending" = 0 ] && return 0
    sleep 2
  done
  die "$* did not become healthy; see: $0 logs <service>"
}

wait_for_stack() {
  say "Waiting for the services"
  for _ in $(seq 1 90); do
    # Services without a health check (Caddy) report nothing and do not count.
    if ! compose ps --format '{{.Health}}' | grep -v '^$' | grep -qvx healthy; then return 0; fi
    sleep 2
  done
  compose ps
  die "not every service became healthy; see: $0 logs <service>"
}

# The pending migrations, each in one transaction with its row in
# supabase_migrations.schema_migrations (as scripts/remote-migrations.sh does).
migrate() {
  psql_db > /dev/null <<'SQL'
create schema if not exists supabase_migrations;
create table if not exists supabase_migrations.schema_migrations (
  version text primary key, statements text[], name text);
SQL
  local applied pending=0
  applied=$(psql_db -c 'select version from supabase_migrations.schema_migrations' < /dev/null)
  for f in "$ROOT"/migrations/*.sql; do
    local base version name
    base=$(basename "$f" .sql)
    version=${base%%_*}
    name=${base#*_}
    grep -qx "$version" <<< "$applied" && continue
    pending=1
    echo "  $base"
    { echo 'begin;'
      cat "$f"
      printf "\ninsert into supabase_migrations.schema_migrations (version, name) values ('%s', '%s');\n" "$version" "$name"
      echo 'commit;'
    } | psql_db > /dev/null
  done
  [ "$pending" = 1 ] || echo "  no pending migrations"
}

schedule() {
  local secret
  secret=$(env_value CRON_SECRET)
  [ -n "$secret" ] || die "CRON_SECRET is empty in stack/.env"
  psql_db -v functions_url="$FUNCTIONS_URL" -v cron_secret="$secret" < "$ROOT/jobs/schedule.sql" \
    | sed 's/^/  /'
  # The stack's own database settings (not migrations, which also run on hosted projects):
  # which header carries the client's address for the rate limits (security review
  # 2026-11-01, F5). Idempotent; a new database gets it from the init scripts as well.
  if [ -f "$STACK/volumes/wuselwall/client-ip.sql" ]; then
    psql_db < "$STACK/volumes/wuselwall/client-ip.sql"
  fi
}

# Prints a token once and stores only its hash. Refuses once a household exists: the
# server belongs to one household (docs/server).
setup_token() {
  local token out
  token=$(openssl rand -hex 12)
  out=$(psql_db <<SQL
do \$\$ begin
  if exists (select 1 from app.household) then
    raise exception 'a household exists already; setup is closed';
  end if;
end \$\$;
delete from app.setup_token;
insert into app.setup_token (token_hash) values (encode(extensions.digest('$token', 'sha256'), 'hex'));
select 'ok';
SQL
)
  [ "$out" = ok ] || die "$out"
  echo "$token"
}

# The Supabase CLI's published JWT secret and keys (and upstream's example JWT secret): an
# .env holding one of them signs or accepts tokens anyone can make (security review
# 2026-11-01, F8; infra/supabase/make-env.mjs refuses them when it writes an .env).
PUBLIC_KEYS=(
  super-secret-jwt-token-with-at-least-32-characters-long
  your-super-secret-jwt-token-with-at-least-32-characters-long
  sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
  sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
)
# Prints the variables of <env file> whose value is a public default; fails when there are none.
public_keys_in() {
  local key found=1
  for key in "${PUBLIC_KEYS[@]}"; do
    if grep -F -- "$key" "$1" > /dev/null; then
      grep -F -- "$key" "$1" | cut -d= -f1
      found=0
    fi
  done
  return "$found"
}

backup() {
  BACKUP_DIR=${BACKUP_DIR:-$ROOT/backups} DB_CONTAINER=$DB \
    BACKUP_ENV=${BACKUP_ENV:-$ROOT/backup.env} bash "$ROOT/backup/backup.sh" "${1:-manual}"
}

# A server-origin web link: the capability stays in the fragment and therefore
# never reaches the web server, its request logs, or a Referer header.
setup_link() {
  local web=${1%/} api=${2%/} token=$3
  if [[ $token =~ ^[0-9a-f]{24}$ ]]; then
    printf '%s/#setup=%s&server=%s\n' "$web" "$token" "$api"
  else
    printf '%s\n' "$api"
  fi
}

show_qr() {
  if command -v qrencode > /dev/null; then
    printf %s "$1" | qrencode -t ANSIUTF8
  else
    echo "  (install qrencode to see a QR code here; the web app shows one as well)"
  fi
}

cmd_install() {
  preflight
  local env_from='' language='' make_args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --env) env_from=$2; shift 2 ;;
      --language) language=${2:?--language needs de, en, fr or es}; make_args+=("$1" "$2"); shift 2 ;;
      --api | --web | --admin-email | --rp-id) make_args+=("$1" "$2"); shift 2 ;;
      --caddy | --studio) make_args+=("$1"); shift ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  case "$language" in ''|de|en|fr|es) ;; *) die 'language must be de, en, fr or es' ;; esac
  [ -e "$STACK/.env" ] && die "stack/.env exists: this server is installed already (use update)"

  umask 077
  if [ -n "$env_from" ]; then
    if public_keys_in "$env_from" > /dev/null; then
      die "$env_from holds a published default key ($(public_keys_in "$env_from" | tr '\n' ' ')); install without --env for fresh keys"
    fi
    say "Taking over the secrets of $env_from"
    cp "$env_from" "$STACK/.env"
    # An .env from before social sign-in was removed: its Apple and Google values go (specs/10).
    sh "$STACK/retire-social-sign-in.sh" "$STACK/.env"
  else
    say "Generating the secrets"
    if command -v node > /dev/null; then
      node "$STACK/make-env.mjs" "${make_args[@]}" > "$STACK/.env.new"
    else
      docker run --rm -v "$STACK/make-env.mjs:/make-env.mjs:ro" "$NODE_IMAGE" \
        node /make-env.mjs "${make_args[@]}" > "$STACK/.env.new"
    fi
    mv "$STACK/.env.new" "$STACK/.env"
  fi
  sh "$STACK/mail-language.sh" "$STACK/.env" "$language"
  set_env WW_SERVER_VERSION "$(cat "$ROOT/VERSION")"
  chmod 600 "$STACK/.env"
  umask 022

  say "Starting the stack (the first start downloads a few GB)"
  compose up -d
  wait_for_db
  wait_for_services auth realtime
  say "Setting up the database"
  migrate
  # PostgREST serves only the api schema, which the migrations just created; without a
  # restart it would wait out its reconnect interval as "unhealthy".
  compose restart rest > /dev/null
  wait_for_stack
  say "Scheduling the nightly jobs"
  schedule

  local api web token
  api=$(env_value SUPABASE_PUBLIC_URL)
  web=$(env_value SITE_URL)
  token=$(setup_token 2> /dev/null || true)
  echo
  say "WuselWall $(cat "$ROOT/VERSION") is running."
  echo "  Server:   $api"
  echo "  Web app:  $web"
  echo "  Email language: $(env_value MAIL_LANGUAGE)"
  echo "  $(sh "$STACK/mail-settings.sh" "$STACK/.env" status | head -n 1)"
  [ -n "$token" ] && echo "  Setup key (shown once; it founds the family, and only its holder can sign up first): $token"
  echo
  echo "  Scan to open setup in your browser, or enter $api in the WuselWall app and tap \"I have the setup key\":"
  [ -n "$token" ] && echo "  Setup link (keep private): $(setup_link "$web" "$api" "$token")"
  show_qr "$(setup_link "$web" "$api" "$token")"
  echo
  say "Now copy $STACK/.env into your password manager."
  echo "  Without it a backup cannot be restored with every device still signed in."
  if ! grep -q 'docker-compose.caddy.yml' "$STACK/.env"; then
    echo
    echo "  Your web server must forward $api to $(env_value GATEWAY_BIND):$(env_value GATEWAY_PORT)"
    echo "  with X-Forwarded-For set to the address it saw (proxy_set_header X-Forwarded-For \$remote_addr;),"
    echo "  and serve $STACK/volumes/web for $web (docs/server/home-server)."
  fi
}

# ---------------------------------------------------------------- release integrity
# A release is three files on GitHub: the archive, SHA256SUMS and SHA256SUMS.minisig, the
# minisign signature of SHA256SUMS whose trusted comment is "wuselwall-server <version>
# SHA256SUMS". Nothing from a release runs before both the signature and the checksum match
# (security review 2026-11-01, F9): `update` runs the new release's own script as root.

release_key_pinned() { [[ $WW_RELEASE_PUBKEY =~ ^RW[A-Za-z0-9+/]{54}$ ]]; }

sha256_of() {
  if command -v sha256sum > /dev/null; then
    sha256sum "$1" | cut -d' ' -f1
  else
    openssl dgst -sha256 -r "$1" | cut -d' ' -f1
  fi
}

# Whether this OpenSSL can check a minisign signature itself: Ed25519 over raw input and
# BLAKE2b-512 (OpenSSL 3). grep without -q: an early exit would kill openssl with SIGPIPE.
openssl_can_verify() {
  openssl list -digest-algorithms 2> /dev/null | grep -i blake2b512 > /dev/null \
    && openssl pkeyutl -help 2>&1 | grep -e -rawin > /dev/null
}

# minisign's verification with openssl alone, for servers without minisign: the key ID must
# match, the signature must cover the BLAKE2b-512 hash of the file (minisign's "ED"; the
# legacy "Ed" over the file itself is refused, see minisig_prehashed), and the global
# signature must cover that signature and the trusted comment, which it prints.
# Formats: https://jedisct1.github.io/minisign/
minisign_openssl() {
  local t rc=0
  t=$(mktemp -d)
  minisign_openssl_in "$t" "$1" "$2" || rc=1
  rm -rf "$t"
  return "$rc"
}

# Every step ends in `|| return 1`: callers run this inside `$(…)` and `||`, where bash
# ignores `set -e`.
minisign_openssl_in() {
  local t=$1 file=$2 sig=$3 alg comment
  printf '%s' "$WW_RELEASE_PUBKEY" | base64 -d > "$t/pub" 2> /dev/null || return 1
  [ "$(wc -c < "$t/pub")" -eq 42 ] && [ "$(head -c 2 "$t/pub")" = Ed ] || return 1
  sed -n 2p "$sig" | base64 -d > "$t/sig" 2> /dev/null || return 1
  [ "$(wc -c < "$t/sig")" -eq 74 ] || return 1
  alg=$(head -c 2 "$t/sig")
  [ "$(tail -c +3 "$t/pub" | head -c 8 | od -An -tx1)" = "$(tail -c +3 "$t/sig" | head -c 8 | od -An -tx1)" ] \
    || return 1
  # The public key as DER (the fixed SubjectPublicKeyInfo prefix of Ed25519, then the key).
  { printf '\060\052\060\005\006\003\053\145\160\003\041\000'; tail -c 32 "$t/pub"; } > "$t/pub.der" || return 1
  tail -c 64 "$t/sig" > "$t/sig.raw" || return 1
  [ "$alg" = ED ] || return 1
  openssl dgst -blake2b512 -binary "$file" > "$t/msg" || return 1
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$t/pub.der" -rawin \
    -in "$t/msg" -sigfile "$t/sig.raw" > /dev/null 2>&1 || return 1
  comment=$(sed -n 3p "$sig")
  [[ $comment == 'trusted comment: '* ]] || return 1
  comment=${comment#trusted comment: }
  { cat "$t/sig.raw" && printf '%s' "$comment"; } > "$t/global" || return 1
  sed -n 4p "$sig" | base64 -d > "$t/global.sig" 2> /dev/null || return 1
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$t/pub.der" -rawin \
    -in "$t/global" -sigfile "$t/global.sig" > /dev/null 2>&1 || return 1
  printf '%s\n' "$comment"
}

# Whether <file.minisig> uses the prehashed algorithm "ED", the only one server-release.yml
# produces. minisign itself still accepts the legacy "Ed", so this is checked first, for both
# verifiers: a signature of another kind was not made by the release workflow.
minisig_prehashed() {
  [ "$(sed -n 2p "$1" | base64 -d 2> /dev/null | head -c 2)" = ED ]
}

# version_lt <a> <b>: whether release a (x.y.z) is older than release b.
version_lt() {
  local IFS=. i
  local -a a=($1) b=($2)
  for i in 0 1 2; do
    [ "${a[i]:-0}" -lt "${b[i]:-0}" ] && return 0
    [ "${a[i]:-0}" -gt "${b[i]:-0}" ] && return 1
  done
  return 1
}

# refuse_downgrade <version> [--allow-downgrade]: an older release would run its migrations'
# expectations against a newer database, and a signed old release with a known flaw must not
# be installable by passing its version (security review 2026-11-01, F9).
refuse_downgrade() {
  local new=$1 allow=${2:-} installed
  installed=$(cat "$ROOT/VERSION" 2> /dev/null || true)
  [[ $new =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $installed =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  if version_lt "$new" "$installed"; then
    [ "$allow" = --allow-downgrade ] \
      || die "release $new is older than the installed $installed: the database may already need $installed. To go back anyway (after a restore of an older backup, say), add --allow-downgrade"
    warn "going back from $installed to $new (--allow-downgrade)"
  fi
}

minisign_hint() {
  cat >&2 <<'EOF'
  Install minisign to check release signatures:
    Debian, Ubuntu:  apt install minisign
    Alpine:          apk add minisign
    Fedora:          dnf install minisign
    Unraid, others:  the static binary from https://github.com/jedisct1/minisign/releases
                     (check its own signature first), copied to /usr/local/bin
EOF
}

# verify_release <archive> <SHA256SUMS> <SHA256SUMS.minisig> [version]
# Checks the signature of SHA256SUMS, then the archive's line in it. With a version (a
# download), the signed comment and the file name must name exactly that version, so an old
# signed release cannot be passed off as a newer one. Prints the version it verified and
# "signed" or "unsigned" (only the checksum was checked).
verify_release() {
  local file=$1 sums=$2 sig=$3 version=${4:-} comment='' rc hash line name signed=unsigned
  [ -f "$sums" ] || die "no SHA256SUMS next to $file: the release cannot be checked"
  if ! release_key_pinned; then
    [ "${WW_REQUIRE_SIGNATURE:-}" = 1 ] && die "this wuselwall has no release key (WW_RELEASE_PUBKEY), and WW_REQUIRE_SIGNATURE=1"
    warn "this wuselwall has no release key pinned: only the checksum is checked, which shows the download is complete but not who built it"
  elif [ ! -f "$sig" ]; then
    die "no SHA256SUMS.minisig next to $file: the release is not signed"
  elif ! minisig_prehashed "$sig"; then
    die "SHA256SUMS.minisig is not a prehashed (ED) minisign signature: the release workflow did not make it"
  else
    rc=0
    if command -v minisign > /dev/null; then
      comment=$(minisign -V -Q -m "$sums" -x "$sig" -P "$WW_RELEASE_PUBKEY") || rc=1
    elif openssl_can_verify; then
      comment=$(minisign_openssl "$sums" "$sig") || rc=1
    else
      rc=2
    fi
    case $rc in
      0) ;;
      1) die "the signature of SHA256SUMS does not match the release key: do not use this release" ;;
      *)
        minisign_hint
        [ "${WW_REQUIRE_SIGNATURE:-}" = 1 ] && die "neither minisign nor OpenSSL 3 can check the signature, and WW_REQUIRE_SIGNATURE=1"
        warn "neither minisign nor OpenSSL 3 is here to check the signature: only the checksum is checked, which shows the download is complete but not who built it"
        ;;
    esac
    if [ -n "$comment" ]; then
      [[ $comment =~ ^wuselwall-server\ ([0-9]+\.[0-9]+\.[0-9]+)\ SHA256SUMS$ ]] \
        || die "the signed comment is not a WuselWall server release: $comment"
      [ -z "$version" ] || [ "${BASH_REMATCH[1]}" = "$version" ] \
        || die "the signature is for release ${BASH_REMATCH[1]}, not $version"
      version=${BASH_REMATCH[1]}
      signed=signed
    fi
  fi
  hash=$(sha256_of "$file")
  line=$(grep -m 1 -E "^$hash [ *]wuselwall-server-[0-9]+\.[0-9]+\.[0-9]+\.tar\.gz$" "$sums" || true)
  [ -n "$line" ] || die "$(basename "$file") does not match SHA256SUMS: a damaged or altered download"
  name=${line##*[ *]}
  [ -z "$version" ] || [ "$name" = "wuselwall-server-$version.tar.gz" ] \
    || die "SHA256SUMS lists this file as $name, not as release $version"
  version=${name#wuselwall-server-}
  echo "${version%.tar.gz} $signed"
}

# fetch_release <version> <directory>: the archive, SHA256SUMS and its signature.
fetch_release() {
  local version=$1 dir=$2 base f
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "not a release version (like 1.2.3) or a file: $version"
  base="https://github.com/$REPO/releases/download/server-v$version"
  say "Downloading WuselWall server $version"
  for f in "wuselwall-server-$version.tar.gz" SHA256SUMS SHA256SUMS.minisig; do
    curl -fsSL -o "$dir/$f" "$base/$f" || die "could not download $base/$f"
  done
}

# check_release <release> <directory>: a version is downloaded into the directory; a file is
# checked against SHA256SUMS and SHA256SUMS.minisig beside it. Prints the archive's path.
# Runs inside `$(…) ||`, where bash ignores `set -e`: every failure exits explicitly.
check_release() {
  local release=$1 dir=$2 file result
  if [ -f "$release" ]; then
    file=$release
    local here
    here=$(dirname "$release")
    if [ ! -f "$here/SHA256SUMS" ]; then
      [ "${WW_REQUIRE_SIGNATURE:-}" = 1 ] && die "no SHA256SUMS next to $release, and WW_REQUIRE_SIGNATURE=1"
      warn "no SHA256SUMS next to $release: the file is not checked. Use only an archive you built or checked yourself."
      echo "$file"
      return 0
    fi
    result=$(verify_release "$file" "$here/SHA256SUMS" "$here/SHA256SUMS.minisig") || exit 1
  else
    fetch_release "$release" "$dir" >&2 || exit 1
    file=$dir/wuselwall-server-$release.tar.gz
    result=$(verify_release "$file" "$dir/SHA256SUMS" "$dir/SHA256SUMS.minisig" "$release") || exit 1
  fi
  case $result in
    *' signed') say "Release ${result% *}: the signature and the checksum match" >&2 ;;
    *) say "Release ${result% *}: the checksum matches (signature not checked)" >&2 ;;
  esac
  echo "$file"
}

# Unpacks [release] (a file or a version) over this directory, once it is checked:
# everything but stack/.env, the database and backups/. Functions and the web app are
# replaced as a whole.
unpack() {
  local release=$1 allow=${2:-} dir file
  dir=$(mktemp -d)
  file=$(check_release "$release" "$dir") || { rm -rf "$dir"; exit 1; }
  # grep without -q reads to the end: an early exit would kill tar with SIGPIPE (pipefail).
  tar -tzf "$file" | grep -x 'wuselwall/wuselwall' > /dev/null \
    || { rm -rf "$dir"; die "$release is not a WuselWall server release"; }
  # The archive's own VERSION, now that it is checked (a file's name proves nothing).
  (refuse_downgrade "$(tar -xzOf "$file" wuselwall/VERSION)" "$allow") || { rm -rf "$dir"; exit 1; }
  rm -rf "$STACK/volumes/functions" "$STACK/volumes/web"
  tar -xzf "$file" -C "$ROOT" --strip-components=1
  rm -rf "$dir"
}

cmd_verify() {
  local release=${1:?usage: verify <release.tar.gz | version>} dir file
  dir=$(mktemp -d)
  file=$(check_release "$release" "$dir") || { rm -rf "$dir"; exit 1; }
  echo "  $(basename "$file"): sha256 $(sha256_of "$file")"
  rm -rf "$dir"
}

cmd_update() {
  local release='' allow='' arg
  for arg in "$@"; do
    case $arg in
      --allow-downgrade) allow=$arg ;;
      --unpacked) release=$arg ;;
      -*) die "update: unknown option $arg" ;;
      *) release=$arg ;;
    esac
  done
  set -- ${release:+"$release"}
  preflight
  [ -e "$STACK/.env" ] || die "not installed yet (use install)"
  if [ "${1:-}" != --unpacked ]; then
    # A version is refused before the backup and the download; a file once it is checked.
    [ -f "${1:-}" ] || refuse_downgrade "${1:-}" "$allow"
    say "Backing up first"
    backup update
    if [ -n "${1:-}" ]; then
      unpack "$1" "$allow"
      # The new release's script finishes the update.
      exec "$ROOT/wuselwall" update --unpacked
    fi
  fi
  say "Updating the stack to $(cat "$ROOT/VERSION")"
  if public_keys_in "$STACK/.env" > /dev/null; then
    warn "stack/.env holds a published default key ($(public_keys_in "$STACK/.env" | tr '\n' ' ')): anyone can sign in as the server itself. Move to fresh keys (docs/server/restore: install without --env, then restore)."
  fi
  # Social sign-in is gone: its Apple and Google values and the native OAuth callback leave
  # the .env before Auth restarts (specs/10).
  sh "$STACK/retire-social-sign-in.sh" "$STACK/.env"
  sh "$STACK/mail-language.sh" "$STACK/.env"
  # The release the app's settings show (the discovery document's server_version).
  set_env WW_SERVER_VERSION "$(cat "$ROOT/VERSION")"
  compose up -d --remove-orphans
  wait_for_db
  wait_for_stack
  say "Database changes"
  migrate
  say "Scheduled jobs"
  schedule
  # A server installed before mail became optional, without mail, needs `mail off` once.
  sh "$STACK/mail-settings.sh" "$STACK/.env" status || true
  say "Done."
}

# Replaces this server's database with [dump] (a db-….dump of backup.sh). Meant for a new
# server installed with the old server's .env (install --env): the same JWT secret, keys
# and Vault key, so every device stays signed in.
cmd_restore() {
  preflight
  local dump=${1:?usage: wuselwall restore <db-….dump>}
  [ -f "$dump" ] || die "no such file: $dump"
  [ -e "$STACK/.env" ] || die "not installed yet: install first (with --env <old .env>)"
  case $dump in
    *.age | *.enc) die "$dump is encrypted: decrypt it into a .dump first (docs/server/restore)" ;;
  esac
  docker exec -i "$DB" pg_restore --list < "$dump" > /dev/null || die "$dump is not a readable backup"

  # A failed count is not "no family" (security review 2026-11-01, F26): only a number lets
  # restore go on, and only 0 without WW_RESTORE_OVER_DATA=yes.
  local households
  households=$(psql_db -c "select count(*) from app.household" < /dev/null) \
    || die "could not count the families on this server (is the database up? $0 status); nothing was changed"
  [[ $households =~ ^[0-9]+$ ]] || die "unexpected answer counting the families: $households; nothing was changed"
  if [ "$households" != 0 ] && [ "${WW_RESTORE_OVER_DATA:-}" != yes ]; then
    die "this server holds a household already; set WW_RESTORE_OVER_DATA=yes to replace it"
  fi
  # Always, also on an empty server: nothing is dropped without a backup of what was there.
  say "Backing up the current database first"
  backup before-restore || die "the backup before the restore failed; nothing was changed"

  say "Stopping everything but the database"
  local services
  services=$(compose ps --services | grep -vx db || true)
  # shellcheck disable=SC2086
  [ -n "$services" ] && compose stop $services

  say "Restoring $(basename "$dump")"
  # supabase_admin is the superuser here (Supabase's postgres role is not). The archive
  # recreates the database with its own settings and owners; roles exist in every stack.
  docker exec "$DB" psql -U supabase_admin -X -q -d template1 -v ON_ERROR_STOP=1 \
    -c 'drop database if exists postgres with (force)' < /dev/null
  local log=$ROOT/backups/restore-$(date +%F-%H%M).log
  # pg_restore's messages may quote data: readable by the owner only.
  (umask 077 && mkdir -p "$ROOT/backups" && : > "$log")
  docker exec -i "$DB" pg_restore -U supabase_admin --create --dbname=template1 < "$dump" 2> "$log" || true
  local errors
  errors=$(grep -c '^pg_restore: error' "$log" || true)
  echo "  pg_restore errors: $errors (details in $log)"

  say "Starting everything"
  compose up -d
  wait_for_stack
  say "Database changes of this release"
  migrate
  say "Scheduled jobs"
  schedule
  psql_db -F ' ' -c "
    select 'households', count(*) from app.household
    union all select 'members', count(*) from app.profile
    union all select 'devices', count(*) from app.device
    union all select 'accounts', count(*) from auth.users" < /dev/null | sed 's/^/  /'
  say "Restored."
}

restart_auth() {
  compose up -d auth functions > /dev/null
  wait_for_services auth
}

# Mail is optional (docs/server "Email"): without it, accounts sign up with a password and a
# guardian (or `wuselwall password`) resets a forgotten one. stack/mail-settings.sh writes the
# .env; the password comes from a prompt or SMTP_PASS, never from the command line.
cmd_mail() {
  local action=${1:-status}
  [ $# -gt 0 ] && shift
  case $action in
    status) sh "$STACK/mail-settings.sh" "$STACK/.env" status ;;
    off)
      sh "$STACK/mail-settings.sh" "$STACK/.env" off
      restart_auth
      sh "$STACK/mail-settings.sh" "$STACK/.env" status
      ;;
    smtp)
      local host='' port=587 user='' sender='' name='' pass=${SMTP_PASS:-}
      while [ $# -gt 0 ]; do
        case $1 in
          --gmail) host=smtp.gmail.com; port=587; shift ;;
          --host) host=${2:?--host needs a host name}; shift 2 ;;
          --port) port=${2:?--port needs 587 or 465}; shift 2 ;;
          --user) user=${2:?--user needs the account name}; shift 2 ;;
          --sender) sender=${2:?--sender needs an address}; shift 2 ;;
          --name) name=${2:?--name needs a sender name}; shift 2 ;;
          *) die "mail smtp: unknown option $1" ;;
        esac
      done
      [ -n "$host" ] || read -rp "SMTP server (e.g. smtp.gmail.com): " host
      [ -n "$user" ] || read -rp "User name (usually your email address): " user
      if [ -z "$pass" ]; then
        read -rsp "Password (for Gmail: the app password): " pass
        echo
      fi
      SMTP_HOST=$host SMTP_PORT=$port SMTP_USER=$user SMTP_PASS=$pass \
        SMTP_SENDER=${sender:-$user} SMTP_SENDER_NAME=$name \
        sh "$STACK/mail-settings.sh" "$STACK/.env" smtp
      restart_auth
      sh "$STACK/mail-settings.sh" "$STACK/.env" status
      echo "  Try it: $0 mail test you@example.org"
      ;;
    test)
      local to=${1:?usage: mail test <address>} host port user from netrc message scheme
      host=$(env_value SMTP_HOST)
      [ -n "$host" ] && [ "$host" != localhost ] || die "no SMTP server is configured (mail smtp)"
      port=$(env_value SMTP_PORT)
      user=$(env_value SMTP_USER)
      from=$(env_value SMTP_ADMIN_EMAIL)
      # Port 465 speaks TLS from the start; 587 and 25 switch to it (required here).
      scheme=smtp
      [ "$port" = 465 ] && scheme=smtps
      netrc=$(mktemp)
      message=$(mktemp)
      # shellcheck disable=SC2064
      trap "rm -f '$netrc' '$message'" EXIT
      printf 'machine %s login %s password %s\n' "$host" "$user" "$(env_value SMTP_PASS)" > "$netrc"
      printf 'From: %s <%s>\r\nTo: <%s>\r\nSubject: WuselWall test\r\n\r\n%s\r\n' \
        "$(env_value SMTP_SENDER_NAME)" "$from" "$to" \
        "This server can send mail. Sign-in codes will arrive like this message." > "$message"
      curl -sS --ssl-reqd --netrc-file "$netrc" --url "$scheme://$host:$port" \
        --mail-from "$from" --mail-rcpt "$to" --upload-file "$message" \
        || die "the SMTP server refused the message (check host, port, user and password)"
      say "Sent to $to. If it does not arrive, look in the spam folder."
      ;;
    *) die "usage: mail [status|smtp|off|test <address>]" ;;
  esac
}

# Prints a one-time code for the account with this address: valid ten minutes, it lets that
# person choose a new password in the app ("Passwort vergessen?"). For a family whose only
# guardian forgot theirs; otherwise a guardian creates the code in Members.
cmd_password() {
  local email=${1:?usage: password <email>} out
  out=$(psql_db -v email="$email" <<'SQL'
select coalesce(app.password_reset_issue_for_email(:'email') ->> 'code', 'none');
SQL
)
  [ "$out" != none ] || die "no account with the address $email"
  echo "Reset code for $email (valid 10 minutes, once): $out"
  echo "  In the app: Continue with email > Forgot password?, then the address, this code and a new password."
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  update) shift; cmd_update "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  language)
    shift; preflight
    [ $# -eq 1 ] || die 'usage: language de|en|fr|es'
    sh "$STACK/mail-language.sh" "$STACK/.env" "$1"
    compose up -d auth functions
    wait_for_services auth
    say "Email language: $1"
    ;;
  backup) shift; preflight; backup "${1:-manual}" ;;
  restore) shift; cmd_restore "$@" ;;
  setup-token) preflight; echo "Setup key (shown once): $(setup_token)" ;;
  migrate) preflight; migrate ;;
  schedule) preflight; schedule ;;
  status) preflight; compose ps ;;
  logs) shift; preflight; compose logs -f --tail=200 "$@" ;;
  compose) shift; preflight; compose "$@" ;;
  mail) shift; preflight; cmd_mail "$@" ;;
  password) shift; preflight; cmd_password "$@" ;;
  *) sed -n '2,/^set -euo pipefail$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
esac
