# WuselWall's Caddy front (docker-compose.caddy.yml). Caddy writes no access log unless
# told to, which is what the privacy policy promises.

(discovery) {
	# The discovery document (ADR-018): the app and the web app read it here.
	handle /.well-known/wuselwall.json {
		rewrite * /functions/v1/server-info
		reverse_proxy api-gw:8000
	}
}

{$WW_API_HOST} {
	import discovery
	# PostgREST's schema listing at the bare prefix: nothing an app needs (S17).
	handle /rest/v1/ {
		respond 404
	}
	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /functions/v1/*
	handle @api {
		reverse_proxy api-gw:8000
	}
	handle {
		respond 404
	}
}

{$WW_WEB_HOST} {
	import discovery
	handle {
		root * /srv/web
		# The same policy as the meta element in app/web/index.html, plus frame-ancestors
		# (security review 2026-11-01, F25): only the web app's own scripts and CanvasKit's
		# WebAssembly, the server over https and wss. The camera only for the page itself.
		header {
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
			X-Frame-Options "DENY"
		}
		try_files {path} /index.html
		file_server
	}
}
