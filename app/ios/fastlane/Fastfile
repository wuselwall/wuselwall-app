# iOS release lanes (specs/16, step 7). The workflow runs `flutter build ios --no-codesign`
# first, which writes the version, build number and dart-defines into Generated.xcconfig;
# this lane only signs, archives and uploads.
default_platform(:ios)

# The App Store Connect API key secrets, checked before use so that a mix-up fails in
# seconds with a message that names the secret, never printing its value.
def asc_key_id
  id = ENV.fetch("ASC_KEY_ID").strip
  UI.user_error!("ASC_KEY_ID must be the 10-character Key ID from App Store Connect → Integrations") unless id.match?(/\A[A-Z0-9]{10}\z/)
  UI.user_error!("ASC_KEY_ID holds the Team ID, not the Key ID") if id == CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  id
end

def asc_issuer_id
  id = ENV.fetch("ASC_ISSUER_ID").strip
  UI.user_error!("ASC_ISSUER_ID must be the Issuer ID (a UUID) from the top of the Team Keys page") unless id.match?(/\A\h{8}-\h{4}-\h{4}-\h{4}-\h{12}\z/)
  id
end

# The .p8 often loses its line breaks on the way into a secret (a password manager's
# single-line field, spaces or literal "\n"), which OpenSSL rejects as "invalid curve
# name". Rebuild the PEM from its base64 body.
def asc_key_pem
  raw = ENV.fetch("ASC_KEY_P8")
  UI.user_error!("ASC_KEY_P8 must be the whole .p8 file, from -----BEGIN PRIVATE KEY----- to -----END PRIVATE KEY-----") unless raw.include?("BEGIN PRIVATE KEY") && raw.include?("END PRIVATE KEY")
  body = raw.gsub(/-----(BEGIN|END) PRIVATE KEY-----/, "").gsub(/\\n|\s/, "")
  pem = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
  begin
    OpenSSL::PKey.read(pem)
  rescue OpenSSL::PKey::PKeyError
    UI.user_error!("ASC_KEY_P8 is not a readable private key: copy the .p8 again, all of it")
  end
  pem
end

# App Store Connect's limits per field (characters; keywords in bytes).
LISTING_LIMITS = {
  "name.txt" => 30, "subtitle.txt" => 30, "promotional_text.txt" => 170,
  "description.txt" => 4000, "keywords.txt" => 100,
}.freeze

# Checks the listing files without App Store Connect: deliver has no dry run, and a field
# over its limit would otherwise fail halfway through an upload.
def check_listing_files
  metadata = File.expand_path("metadata")
  locales = Dir.children(metadata).select { |d| d.match?(/\A[a-z]{2}(-[A-Za-z]+)?\z/) }.sort
  UI.user_error!("no locale folders in #{metadata}") if locales.empty?
  errors = locales.flat_map do |locale|
    LISTING_LIMITS.filter_map do |file, limit|
      path = File.join(metadata, locale, file)
      next "#{locale}/#{file} is missing" unless File.exist?(path)
      text = File.read(path, encoding: "UTF-8").strip
      size = file == "keywords.txt" ? text.bytesize : text.length
      "#{locale}/#{file} is #{size} long, the limit is #{limit}" if text.empty? || size > limit
    end
  end
  UI.user_error!(errors.join("\n")) unless errors.empty?

  require "deliver"
  shots = Deliver::Loader.load_app_screenshots(File.expand_path("screenshots"), false)
  shots.group_by { |s| [s.language, s.display_type] }.sort.each do |(language, type), list|
    UI.message("#{language} #{type}: #{list.count} screenshots")
  end
  missing = locales.product(["APP_IPHONE_67", "APP_IPAD_PRO_3GEN_129"]) - shots.map { |s| [s.language, s.display_type] }
  UI.user_error!("no screenshots for #{missing.map { |m| m.join(' ') }.join(', ')}") unless missing.empty?
  UI.success("Listing files of #{locales.join(', ')} are within App Store Connect's limits")
end

platform :ios do
  desc "Sign with the match profile, archive and upload to TestFlight"
  lane :beta do
    setup_ci if is_ci # temporary keychain, match read-only

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_content: asc_key_pem,
    )

    # Read-only, except once after a capability changes on the App ID (Sign in with
    # Apple, associated domains): "Run workflow" with renew_profile regenerates the
    # App Store profile so that it carries the new entitlement.
    renew = ENV["MATCH_RENEW"] == "1"
    match(readonly: !renew, force: renew, api_key: api_key)

    # The project keeps automatic signing for local development; the release archive
    # uses the distribution certificate and profile from match.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: "JSX2VQXW7G",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_ch.goomba.wuselwall_appstore_profile-name"),
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
    )

    # Internal testers receive the build once Apple has processed it; CI does not wait.
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  # The App Store listing in fastlane/metadata and fastlane/screenshots
  # (scripts/store-listing.mjs renders them), uploaded on its own by store-listing.yml, never
  # with a build and never submitted for review. APP_VERSION names the version it edits
  # (created, or the version being prepared renamed). LISTING_VALIDATE_ONLY=1 checks the
  # files and reads that version from App Store Connect without changing anything.
  desc "Upload the App Store listing (texts and screenshots)"
  lane :listing do
    check_listing_files
    version = ENV.fetch("APP_VERSION", "").strip
    UI.user_error!("APP_VERSION must be the version to edit, like 1.4.0") unless version.match?(/\A\d+\.\d+\.\d+\z/)

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_content: asc_key_pem,
    )

    if ENV["LISTING_VALIDATE_ONLY"] == "1"
      app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
      UI.user_error!("the app is not in App Store Connect, or the API key cannot see it") unless app
      editing = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
      if editing
        UI.message("Version being prepared: #{editing.version_string} (#{editing.app_store_state})")
      else
        UI.message("No version being prepared; the upload would create #{version}")
      end
      UI.success("Validated only: nothing was changed in App Store Connect")
    else
      deliver(
        api_key: api_key,
        app_version: version,
        skip_binary_upload: true,
        overwrite_screenshots: true,
        force: true, # no HTML preview to confirm on CI
        submit_for_review: false,
        run_precheck_before_submit: false,
      )
    end
  end
end
