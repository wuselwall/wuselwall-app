# Copy to supabase/.env (git-ignored, chmod 600). The values below are the CLI's public
# defaults, fine for a throwaway stack on a laptop; a live server has its own (specs/10).
WW_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
WW_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
WW_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# An SMTP relay (specs/10 "Email setup"), only for a live server's compose stack. CLI
# stacks always use Mailpit.
WW_SMTP_USER=
WW_SMTP_PASS=

# Sign in with Apple and Google (specs/10 §4). Used by a laptop stack only when
# config.toml's [auth.external.*] is switched on, and by make-env.mjs for a new server's
# stack. Client IDs, comma-separated, redirect client first.
WW_APPLE_CLIENT_IDS=
WW_APPLE_SECRET=
WW_GOOGLE_CLIENT_IDS=
WW_GOOGLE_CLIENT_SECRET=
