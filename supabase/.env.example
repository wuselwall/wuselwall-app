# Copy to supabase/.env (git-ignored, chmod 600). The values below are the CLI's public
# defaults, fine for a throwaway stack on a laptop; a live server has its own (specs/10).
WW_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
WW_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
WW_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Optional mail for a server's compose stack, taken over by `remote-stack.sh init-env`
# (make-env.mjs). Without SMTP_HOST the server sends no mail: sign-in with passwords only.
# CLI stacks always use Mailpit. Gmail: smtp.gmail.com, 587, the address, an app password.
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SENDER=wuselwall@example.org
