# Copy to supabase/.env (git-ignored, chmod 600) and replace the three placeholders:
#   WW_JWT_SECRET       openssl rand -hex 32
#   WW_PUBLISHABLE_KEY  sb_publishable_ followed by: openssl rand -base64 16 | tr '+/' '-_' | tr -d =
#   WW_SECRET_KEY       sb_secret_ followed by the same command's output (a second run)
# A throwaway stack on a laptop may use the CLI's public defaults instead (backend-ci.yml
# writes them; app/env/ci.json expects that publishable key). Never let them reach a server:
# make-env.mjs (`scripts/remote-stack.sh init-env`) refuses them and these placeholders, and
# takes over only keys of this server's own (specs/10).
WW_JWT_SECRET=replace-me-with-openssl-rand-hex-32-output
WW_PUBLISHABLE_KEY=sb_publishable_replace-me
WW_SECRET_KEY=sb_secret_replace-me

# Optional mail for a server's compose stack, taken over by `remote-stack.sh init-env`
# (make-env.mjs). Without SMTP_HOST the server sends no mail: sign-in with passwords only.
# CLI stacks always use Mailpit. Gmail: smtp.gmail.com, 587, the address, an app password.
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SENDER=wuselwall@example.org
