{
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "vite": "^6.4.4"
  },
  "private": true,
  "license": "Apache-2.0",
  "name": "wuselwall",
  "scripts": {
    "repo:check": "node --test scripts/repository-boundaries.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "remote:deploy": "scripts/remote-stack.sh deploy",
    "remote:status": "scripts/remote-stack.sh ps",
    "remote:migrate": "scripts/remote-migrate.sh",
    "remote:pgtap": "scripts/remote-pgtap.sh",
    "brand": "node scripts/brand-assets.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:demo": "cd app && flutter build web -t lib/main_demo.dart --release -o build/web-demo",
    "docs:screenshots": "npm run docs:demo && node docs/tools/screenshots.mjs",
    "docs:check": "node docs/tools/check-locales.mjs && node docs/tools/check-shots.mjs",
    "store:listing": "node scripts/store-listing.mjs",
    "docs:browser": "node docs/tools/browser.mjs",
    "qualify:check": "node --test qualification/*.test.mjs qualification/native/*.test.mjs && node qualification/generate-native.mjs --check",
    "qualify:build-web": "cd app && flutter build web --release --no-web-resources-cdn -t qualification/main.dart -o build/web-qualification",
    "qualify:web": "node qualification/run-web.mjs",
    "qualify:pixel-controls": "playwright test -c qualification/pixel-controls.config.mjs",
    "qualify:scroll-controls": "playwright test -c qualification/scroll-audit.config.mjs",
    "qualify:font-policy": "playwright test -c qualification/font-policy.config.mjs"
  }
}
